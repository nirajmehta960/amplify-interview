# ─────────────────────────────────────────────────────────────
#  Frontend environment (Vite)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Only VITE_-prefixed vars are exposed
# to the browser, and they are INLINED AT BUILD TIME — restart the
# dev server (or rebuild) after changing anything here.
#
# ⚠️ Everything here ships in the public JS bundle. Never put a
#    secret in this file.

# ── Backend API ──────────────────────────────────────────────
# Local dev: the FastAPI server runs on port 4000.
# Production: https://api.<your-domain>
VITE_API_URL=http://localhost:4000

# ── AWS Cognito (authentication) ─────────────────────────────
# From deployment_plan Phase 4. The client ID is a PUBLIC client
# identifier by design — safe to inline.
#
# ⚠️ Leaving VITE_AWS_COGNITO_CLIENT_ID EMPTY puts the app in MOCK
#    AUTH mode: any email/password signs in and the literal token
#    "mock-user-token" is stored. Convenient locally; a production
#    build missing this value accepts ANY password. Always verify
#    it is set in production builds.
VITE_AWS_REGION=us-east-1
VITE_AWS_COGNITO_CLIENT_ID=

# ── Analytics (optional) ─────────────────────────────────────
# Leave empty to disable Google Analytics entirely.
VITE_GA4_MEASUREMENT_ID=
