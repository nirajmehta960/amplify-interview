###############################
#  App Configuration
###############################
APP_NAME="Amplify Interview API"
DEBUG=true
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080


###############################
#  GCP Configuration
###############################
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=amplify-interview-uploads
FIRESTORE_DATABASE=(default)


###############################
#  Firebase Auth
###############################
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to Firebase service account JSON (for local development)
# On Cloud Run, uses Application Default Credentials automatically
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json


###############################
#  LLM — OpenAI directly OR OpenRouter (OpenAI-compatible API)
###############################
# OpenAI: leave OPENAI_API_BASE unset (or empty). Keys from https://platform.openai.com/api-keys
# OpenRouter: set base URL + key from https://openrouter.ai/keys — models use provider prefix.
OPENAI_API_KEY=sk-your-openai-or-openrouter-key
OPENAI_API_BASE=
# Examples — OpenAI: gpt-4o-mini | OpenRouter: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, etc.
OPENAI_MODEL_DEFAULT=gpt-4o-mini
OPENAI_MODEL_ADVANCED=gpt-4o
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60


###############################
#  Email (Resend)
###############################
# In production, bind from Secret Manager: amplify-resend-api-key
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=Amplify Interview <noreply@amplifyinterview.com>
APP_URL=http://localhost:3000


###############################
#  Speech-to-Text (Cloud STT)
###############################
GCP_SPEECH_LANGUAGE=en-US


###############################
#  Rate Limiting
###############################
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10


###############################
#  Session Defaults
###############################
MAX_QUESTIONS_PER_SESSION=20
DEFAULT_QUESTION_COUNT=10
MAX_RESUME_SIZE_MB=10
MAX_JD_LENGTH=10000
