# ─────────────────────────────────────────────────────────────
#  Backend environment (FastAPI)
# ─────────────────────────────────────────────────────────────
# Copy to `backend/.env` and fill in. `.env` is gitignored.
#
# Every variable here is read ONLY through app/config.py's Settings
# object — nothing else touches os.environ. Every field has a default,
# so the app boots without a .env; features degrade instead of failing.
#
# In production these come from SSM Parameter Store, not a file
# (see docs/deployment_plan/PHASE_06_rds.md).

# ─── REQUIRED for local development ──────────────────────────

# development | staging | production
#
# ⚠️ SECURITY: when ENVIRONMENT=development, middleware/auth.py accepts
#    the literal token "mock-user-token" as a valid user. Deployed
#    environments MUST set this to `production` or you ship an auth bypass.
ENVIRONMENT=development

# Enables /docs and /redoc, and SQL echo once Postgres lands. Never true in prod.
DEBUG=true

# Comma-separated list (a JSON array also works). Must include the Vite
# dev server origin — it runs on port 3000, not 5173.
ALLOWED_ORIGINS=http://localhost:3000

# LLM. Required for every AI feature: parsing, matching, questions, feedback.
# A placeholder value lets the app boot; calls will fail until it is real.
OPENAI_API_KEY=

# ─── AWS ─────────────────────────────────────────────────────
# Credentials are intentionally absent: boto3 resolves them from
# ~/.aws/credentials locally and from the EC2 instance role in production.
# Only set the keys below if you cannot use either.
#
# ⚠️ db/dynamodb.py and db/storage.py AUTO-CREATE real DynamoDB tables and
#    the S3 bucket on first use. With valid credentials, hitting a data
#    endpoint locally will touch your real AWS account.

AWS_REGION=us-east-1
AWS_S3_BUCKET=amplify-interview-uploads
AWS_DYNAMODB_TABLE_PREFIX=amplify_

# Cognito — from deployment_plan Phase 4. Leave the pool ID empty to rely on
# the development mock-token path above.
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=

# Only needed when not using ~/.aws/credentials or an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Optional ────────────────────────────────────────────────

# Leave empty for official OpenAI. For OpenRouter: https://openrouter.ai/api/v1
OPENAI_API_BASE=
OPENAI_MODEL_DEFAULT=gpt-4o-mini
OPENAI_MODEL_ADVANCED=gpt-4o
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60

# Transcription language for AWS Transcribe.
AWS_TRANSCRIBE_LANGUAGE=en-US

# Email (Resend). Welcome emails are skipped silently if unset.
RESEND_API_KEY=
EMAIL_FROM=Amplify Interview <noreply@amplifyinterview.com>
APP_URL=https://amplifyinterview.com

# Rate limiting. NOTE: storage is in-memory, so limits are per worker process.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# Session tuning.
MAX_QUESTIONS_PER_SESSION=20
DEFAULT_QUESTION_COUNT=10
MAX_RESUME_SIZE_MB=10
MAX_JD_LENGTH=10000
