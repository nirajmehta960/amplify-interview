###############################
#  App Configuration
###############################
APP_NAME="Amplify Interview API"
DEBUG=true
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080


###############################
#  GCP Configuration
###############################
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=amplify-interview-uploads
FIRESTORE_DATABASE=(default)


###############################
#  Firebase Auth
###############################
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to Firebase service account JSON (for local development)
# On Cloud Run, uses Application Default Credentials automatically
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json


###############################
#  OpenAI API
###############################
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL_DEFAULT=gpt-4o-mini
OPENAI_MODEL_ADVANCED=gpt-4o
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60


###############################
#  Rate Limiting
###############################
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10


###############################
#  Session Defaults
###############################
MAX_QUESTIONS_PER_SESSION=20
DEFAULT_QUESTION_COUNT=10
MAX_RESUME_SIZE_MB=10
MAX_JD_LENGTH=10000
